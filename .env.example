# DemoQA credentials - copy this file to .env and fill in your values
# Never commit the real .env file to version control
DEMOQA_USERNAME=your_username_here
DEMOQA_PASSWORD=your_password_here

# Base URLs (defaults already set in playwright.config.ts)
DEMOQA_BASE_URL=https://demoqa.com
REQRES_BASE_URL=https://reqres.in

# Optional: slow motion in ms for headed runs
SLOW_MO=0
